{
  "name": "@wallet-trade/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.5.0"
  },
  "scripts": {
    "build": "pnpm exec tsc --project tsconfig.json --noEmit --pretty false",
    "type-check": "pnpm exec tsc --project tsconfig.json --noEmit --pretty false",
    "db:generate": "pnpm exec prisma generate --schema ./prisma/schema.prisma",
    "db:push": "pnpm exec prisma db push --schema ./prisma/schema.prisma",
    "db:studio": "pnpm exec prisma studio --schema ./prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/node": "^20.2.5",
    "prisma": "^6.19.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
