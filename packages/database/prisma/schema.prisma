model PerpOrder {
  id        String   @id @default(uuid())
  chainId   Int      @default(11155111) @map("chain_id")
  account   String
  token     String
  isLong    Boolean
  sizeDelta String
  triggerPrice String? // For Limit/Stop orders
  type      String   // MARKET, LIMIT, STOP
  status    String   // PENDING, FILLED, CANCELLED
  txHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chainId])
  @@index([chainId, account])
  @@index([chainId, token])
  @@index([chainId, status])
  @@index([account])
  @@index([status])
  @@map("perp_orders")
