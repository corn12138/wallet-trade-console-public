// ────────────────────────────────────────────────────────────────────────────
// Server-owned i18n (2026-07-10). PostgreSQL published revisions are the
// runtime source of truth for translations; the Go service owns catalog
// reads, draft writes, validation, publication, rollback and auditing.
// ────────────────────────────────────────────────────────────────────────────

// Locale metadata. Exactly one enabled locale is the default — the Go
// service enforces that invariant on every mutation.
model I18nLocale {
  code        String   @id @db.VarChar(35) // normalized BCP-47-compatible code
  englishName String   @map("english_name") @db.VarChar(80)
  nativeName  String   @map("native_name") @db.VarChar(80)
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false) @map("is_default")
  createdBy   String?  @map("created_by") @db.VarChar(42)
  updatedBy   String?  @map("updated_by") @db.VarChar(42)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  drafts    I18nMessageDraft[]
  revisions I18nCatalogRevision[]

  @@map("i18n_locales")
}

// Editable draft value for one message key. Publication snapshots all
// drafts of a locale into an immutable revision.
model I18nMessageDraft {
  id         String   @id @default(cuid())
  localeCode String   @map("locale_code") @db.VarChar(35)
  namespace  String   @db.VarChar(120)
  messageKey String   @map("message_key") @db.VarChar(240)
  value      String   @db.Text
  version    Int      @default(1) // optimistic concurrency token
  updatedBy  String?  @map("updated_by") @db.VarChar(42)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  locale I18nLocale @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([localeCode, namespace, messageKey])
  @@index([localeCode, namespace, messageKey])
  @@map("i18n_message_drafts")
}

// Immutable published catalog snapshot. Rollback creates a NEW revision
// from an old snapshot; history is never mutated or deleted.
model I18nCatalogRevision {
  id               String   @id @default(cuid())
  localeCode       String   @map("locale_code") @db.VarChar(35)
  version          Int      // monotonically increasing per locale
  catalog          Json     // complete nested messages object
  checksum         String   @db.VarChar(64) // SHA-256 of canonical JSON
  publishedBy      String   @map("published_by") @db.VarChar(42)
  publishedAt      DateTime @default(now()) @map("published_at")
  sourceRevisionId String?  @map("source_revision_id") // set on rollback

  locale I18nLocale @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([localeCode, version])
  @@index([localeCode, publishedAt(sort: Desc)])
  @@map("i18n_catalog_revisions")
}

// Append-only audit trail for every i18n mutation. Metadata carries
// structured before/after values and never secrets.
model I18nAuditLog {
  id         String   @id @default(cuid())
  actor      String   @db.VarChar(42) // verified SIWE wallet
  action     String   @db.VarChar(40) // draft.update / publish / rollback / locale.*
  localeCode String?  @map("locale_code") @db.VarChar(35)
  namespace  String?  @db.VarChar(120)
  messageKey String?  @map("message_key") @db.VarChar(240)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([localeCode, createdAt(sort: Desc)])
  @@index([actor, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("i18n_audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Reference price storage.
//
// The perp/token candle tables above are projections of OUR OWN on-chain
// activity (perp_trades / token_trades). On a testnet that activity is sparse,
// so the trading chart has nothing to draw. These two tables persist REAL
// external price truth so the chart is dense and live, and every row records
// which source it came from — the API and UI always label the source and never
// blend it with on-chain trade candles.
// ─────────────────────────────────────────────────────────────────────────────

// Materialized OHLCV pulled from a public spot-market data provider (see
// internal/pricefeed). `source` is the provider id (e.g. "gateio"); the same
// symbol may be stored from several providers side by side without collision.
model MarketCandle {
  id          String   @id @default(cuid())
  source      String   @db.VarChar(32) // provider id, e.g. "gateio"
  symbol      String   @db.VarChar(32) // canonical market symbol, e.g. "ETH-USD"
  resolution  String   @db.VarChar(8) // 1m, 5m, 15m, 1h, 4h, 1d
  bucketStart DateTime @map("bucket_start") // UTC bucket start
  open        Decimal  @db.Decimal(38, 18)
  high        Decimal  @db.Decimal(38, 18)
  low         Decimal  @db.Decimal(38, 18)
  close       Decimal  @db.Decimal(38, 18)
  volume      Decimal  @db.Decimal(38, 18) // base-asset volume
  quoteVolume Decimal  @map("quote_volume") @db.Decimal(38, 18)
  closed      Boolean  @default(true) // false = still-forming bucket
  ingestedAt  DateTime @default(now()) @map("ingested_at")

  // Idempotency key: re-ingesting the same window updates in place, so the
  // still-forming candle converges instead of duplicating.
  @@unique([source, symbol, resolution, bucketStart])
  @@index([symbol, resolution, bucketStart(sort: Desc)])
  @@map("market_candles")
}

// Append-only log of on-chain oracle price rounds (Chainlink aggregators read
// over the same RPC the indexer already uses). One row per distinct oracle
// round — polling the same round repeatedly is a no-op, so this table records
// genuine oracle updates rather than sample noise.
model OraclePriceObservation {
  id          String   @id @default(cuid())
  source      String   @db.VarChar(32) // "chainlink"
  symbol      String   @db.VarChar(32) // "ETH-USD"
  chainId     Int      @map("chain_id")
  feedAddress String   @map("feed_address") @db.VarChar(42)
  roundId     String   @map("round_id") @db.VarChar(80) // uint80 as decimal string
  price       Decimal  @db.Decimal(38, 18) // normalized to whole USD units
  decimals    Int // aggregator decimals, kept for auditability
  observedAt  DateTime @map("observed_at") // aggregator updatedAt
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@unique([chainId, feedAddress, roundId])
  @@index([symbol, observedAt(sort: Desc)])
  @@index([chainId, feedAddress, observedAt(sort: Desc)])
  @@map("oracle_price_observations")
}

// Durable cross-chain transfer log — the projection of real BridgeGateway
// events, and the only thing GET /api/bridge/status reads.
//
// Before this table the bridge endpoint returned a constant fixture and had no
// transfer state at all. A row is created ONLY from an observed on-chain
// BridgeInitiated event, and it advances to FULFILLED/REFUNDED only from the
// matching on-chain event — the relayer never writes an optimistic status.
model BridgeTransfer {
  id String @id @default(cuid())

  // Deterministic id from the source gateway: keccak(srcChainId, gateway, nonce).
  // Globally unique by construction, which is why it — not the tx hash — is the
  // idempotency key: one deposit is one transfer, even across gateway redeploys.
  transferId String @map("transfer_id") @db.VarChar(66)

  srcChainId Int    @map("src_chain_id")
  dstChainId Int    @map("dst_chain_id")
  srcGateway String @map("src_gateway") @db.VarChar(42)

  sender    String  @db.VarChar(42)
  recipient String  @db.VarChar(42)
  srcToken  String  @map("src_token") @db.VarChar(42)
  dstToken  String? @map("dst_token") @db.VarChar(42) // known once the route resolves

  // Base units as an exact integer — uint256 never goes through a float.
  amount Decimal @db.Decimal(78, 0)

  /// INITIATED | FULFILLED | REFUNDED | FAILED
  status String @db.VarChar(24)

  depositTxHash   String   @map("deposit_tx_hash") @db.VarChar(66)
  depositLogIndex Int      @map("deposit_log_index")
  depositBlock    BigInt   @map("deposit_block")
  depositedAt     DateTime @map("deposited_at")

  fulfillTxHash String?   @map("fulfill_tx_hash") @db.VarChar(66)
  fulfillBlock  BigInt?   @map("fulfill_block")
  fulfilledAt   DateTime? @map("fulfilled_at")

  refundTxHash String?   @map("refund_tx_hash") @db.VarChar(66)
  refundedAt   DateTime? @map("refunded_at")

  // Why a transfer is stuck, surfaced verbatim by the status endpoint instead
  // of a generic "pending" that hides an operational failure.
  lastError String? @map("last_error")
  attempts  Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([srcChainId, transferId])
  @@index([sender, createdAt(sort: Desc)])
  @@index([recipient, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([srcChainId, depositBlock])
  @@map("bridge_transfers")
}

/// Relayer liveness. Without it a stopped relayer and a healthy idle one look
/// identical — both leave bridge_transfers unchanged — so a bridge can be
/// silently deposit-only. The relayer upserts one row per cycle; the product
/// status endpoint reads it and reports stale/absent honestly.
model BridgeRelayerHeartbeat {
  relayerAddress String @id @map("relayer_address") @db.VarChar(42)

  lastSeenAt DateTime @map("last_seen_at")
  chains     Int[]    @default([])

  /// {"84532": "14998442370960000"} — wei as an exact string, never a float.
  gasBalances Json? @map("gas_balances")

  /// False when no signer is configured: the relayer observes but cannot deliver.
  canDeliver Boolean @default(false) @map("can_deliver")

  /// The last cycle error verbatim, so "up but failing every 15s" is visible.
  lastCycleError String? @map("last_cycle_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lastSeenAt(sort: Desc)])
  @@map("bridge_relayer_heartbeat")
}
