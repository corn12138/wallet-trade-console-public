model PerpTrade {
  id        String   @id @default(uuid())
  chainId   Int      @default(11155111) @map("chain_id")
  account   String
  token     String
  isLong    Boolean
  sizeDelta String
  price     String
  fee       String
  pnl       String?
  type      String   // INCREASE, DECREASE, LIQUIDATION
  txHash    String
  logIndex  Int?     @map("log_index") // chain event identity; NULL for legacy/manual rows
  blockNumber Int
  createdAt DateTime @default(now())

  // Idempotency key for the chain-event projection: one PerpMarket event =
  // one trade row (NULL logIndex rows stay distinct per Postgres semantics).
  @@unique([chainId, txHash, logIndex])
  @@index([chainId])
  @@index([chainId, account])
  @@index([chainId, token])
  @@index([chainId, type])
  @@index([account])
  @@index([token])
  @@index([type])
  @@map("perp_trades")
