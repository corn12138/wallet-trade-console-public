# services/api-go — public environment contract
#
# Copy to services/api-go/.env and fill local values. Never commit the filled
# file, production endpoints, or signer material.
#
# Only the database block is required for the API to serve data; everything else
# degrades to a documented "not configured" behavior (see internal/httpx/server.go).

# ─── Listen address ──────────────────────────────────────────────────────────
# PORT is turned into ":$PORT". API_GO_LISTEN_ADDR overrides it with a full
# address. Default when neither is set: ":8080".
PORT=8080
# API_GO_LISTEN_ADDR=:8080

# ─── Database (REQUIRED) ──────────────────────────────────────────────────────
# Preferred: a single URL. PgBouncer-compatible URLs are supported.
DATABASE_URL=postgresql://app_user:password@127.0.0.1:6543/wallet_trade_console?schema=public
#
# Or the compound form (used when DATABASE_URL is unset):
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=6543
# DATABASE_NAME=wallet_trade_console
# DATABASE_USER=app_user
# DATABASE_PASSWORD=password
# DATABASE_PASSWORD_BASE64=        # base64 of the password (takes precedence over DATABASE_PASSWORD)
# DATABASE_PASSWORD_ENCODING=      # set to "base64" to decode DATABASE_PASSWORD itself
# DATABASE_SSL=                    # "true"/"require" to force TLS

# ─── Auth / SIWE (enables guarded routes + /auth, /web3-auth) ────────────────
# Without JWT_SECRET the guarded mutation routes do not mount and SIWE /me 401s.
# Must be >= 32 chars in production (NODE_ENV=production).
JWT_SECRET=
JWT_REFRESH_SECRET=
# CSRF signer for the cookie auth flow; SECURITY_CSRF_SECRET is the fallback name.
CSRF_SECRET=
# SECURITY_CSRF_SECRET=

# ─── Contracts (markets/swap/earn deployment + ABI lookups) ──────────────────
# Resolution order (deployments.DiscoverDir, same for api/indexer/market-stream):
#   1. CONTRACTS_DEPLOYMENTS_DIR when set (the Docker image sets it to the
#      baked-in /app/packages/shared/deployments);
#   2. otherwise the nearest ancestor packages/shared/deployments — so a repo
#      checkout (`pnpm dev:api`) finds the live registry with NO env needed.
# A stale/missing registry makes /api/markets/symbols return [] and degrades
# swap quotes to the non-executable fallback (the strict smokes catch both).
# CONTRACTS_DEPLOYMENTS_DIR=/app/packages/shared/deployments
# CONTRACTS_ABIS_DIR=/app/packages/shared/abis

# ─── On-chain RPC (live swap quote; indexer) ─────────────────────────────────
# SEPOLIA_RPC_URL is preferred; SEPOLIA_HTTPS_RPC is the fallback name.
# Without it swap quotes remain fallback-only and never executable. The same
# variable drives cmd/indexer backfill.
# SEPOLIA_RPC_URL=
# SEPOLIA_HTTPS_RPC=
# SEPOLIA_WSS_RPC=        # websocket endpoint for the indexer (cmd/indexer)

# ─── Realtime Socket.IO tier (REQUIRED in production deployments) ────────────
# REALTIME_ENABLED=1 (or true) mounts /socket.io/ with the markets and
# token-events namespaces. Token-events DELIVERY additionally requires the
# database block above: cmd/api starts the eventbus LISTEN loop (Postgres
# channel wtc_token_events, fed by cmd/indexer's committed projections) only
# when REALTIME_ENABLED is on AND a DB pool is configured. Leaving this unset
# serves REST only — the token-events namespace stays silent.
REALTIME_ENABLED=1
# Market-stream knobs (see cmd/api/realtime.go): MARKET_STREAM_ENABLED,
# MARKET_STREAM_RUN_IN_API, MARKET_STREAM_REDIS_URL / REDIS_URL.

# ─── Paper trading (dev-only fake order seeder; keep OFF in production) ──────
# PAPER_TRADE_ENABLED=1 mounts POST/GET /api/paper-orders and lets paper
# (txHash-less) rows appear in orderbook/pending-order reads. Default off:
# the routes answer 503 and trading reads exclude paper rows.
# PAPER_TRADE_ENABLED=0

# ─── LiveKit (token issuer; degrades to "not configured") ────────────────────
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_WS_URL=

# ─── Media uploads (Create Token icon/banner + NFT Studio artwork/metadata) ──
# MEDIA_STORAGE selects the provider: "local" | "s3" | "disabled".
# Unset = local storage in non-production, DISABLED in production (uploads
# answer 503) — production must opt in to a persistent volume or S3/R2.
# MEDIA_STORAGE=local
# MEDIA_LOCAL_DIR=data/media-uploads       # point at a persistent volume in prod
# MEDIA_PUBLIC_BASE_URL=                   # e.g. https://api.example.com (optional; defaults to request origin)
#
# S3-compatible (AWS S3 / Cloudflare R2 / MinIO); all five are required:
# MEDIA_STORAGE=s3
# MEDIA_S3_ENDPOINT=                       # e.g. https://<account>.r2.cloudflarestorage.com
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=auto
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_PUBLIC_BASE_URL=                # public bucket / CDN base for reads

# ─── AI tx-review explanations (optional; OFF by default) ────────────────────
# Adds a plain-language summary on top of a transaction review that the
# deterministic rules engine has ALREADY decided. The model never changes a
# verdict: with this off (or on a timeout, a 429, or malformed output),
# POST /api/security/tx-review/explain answers 200 with source="static" and the
# UI renders the deterministic check text — a complete, normal experience.
# Leaving these unset is a supported production configuration.
# AI_ENABLED=true
# DEEPSEEK_API_KEY=                        # required when AI_ENABLED=true
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-flash               # use deepseek-v4-pro only when higher prose quality justifies latency/cost
# AI_TIMEOUT_SECONDS=12
# AI_MAX_TOKENS=2048

# ─── Indexer worker (cmd/indexer only — separate binary, not the API) ────────
# INDEXER_LOCAL=false
# FACTORY_ADDRESS=
# ROUTER_ADDRESS=
# INDEXER_DEPLOY_BLOCK=0
# INDEXER_BATCH_SIZE=2000
# INDEXER_CONFIRMATION_DEPTH=5
# INDEXER_POLL_INTERVAL_MS=12000
# INDEXER_BACKFILL_MAX_RETRIES=5
# INDEXER_MAX_RECONNECT_ATTEMPTS=10

# ─── Misc ────────────────────────────────────────────────────────────────────
# NODE_ENV=production   # enables the >=32-char secret validation

# Production SIWE requires Redis >= 6.2 and fails closed without it.
# Local development defaults to memory; no production credentials belong here.
# SIWE_NONCE_STORE=redis
# SIWE_NONCE_REDIS_URL=redis://127.0.0.1:6379
# SIWE_NONCE_REDIS_PREFIX=web3auth:siwe:nonce
